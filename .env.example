# Copy to .env (root) and to apps/api/.env / apps/web/.env.local as needed.
# See docs/architecture/environment-variables.md for full documentation.

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://railcards:railcards_dev_password@localhost:5432/railcards?schema=public"

# ── Redis (cache, presence, BullMQ) ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API ──────────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# JWT secrets — generate real random 32+ byte secrets for staging/production,
# e.g. `openssl rand -base64 48`. Never commit real secrets.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Cookie signing / CSRF
COOKIE_SECRET="dev-cookie-secret-change-me"

# ── Feature flags / product config ──────────────────────────────────────
INVITE_ONLY_MODE="true"
TRADE_CR_ENABLED="true"
MARKET_FEE_BPS="500"

# ── Object storage (S3-compatible). Leave blank to use local disk storage
# in development (see apps/api/storage). ────────────────────────────────
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="railcards-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ── Email (transactional). Leave blank to log emails to console in dev. ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="RailCards <no-reply@railcards.example>"

# ── Observability (optional) ─────────────────────────────────────────────
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ── Frontend (public) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# ── Coolify / docker-compose.yml only ────────────────────────────────────
# The Postgres container's own credentials (docker-compose.yml builds
# DATABASE_URL from these — you don't set DATABASE_URL directly there).
POSTGRES_USER="railcards"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="railcards"
