// RailCards — Prisma schema
// Design decisions are documented in docs/architecture/data-model.md

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  emailVerifiedAt   DateTime?
  username          String     @unique
  passwordHash      String
  displayName       String
  avatarUrl         String?
  role              UserRole   @default(USER)
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions              Session[]
  invitationsCreated    Invitation[]        @relation("InvitationCreatedBy")
  invitationUsed        Invitation?         @relation("InvitationUsedBy")
  cardInstances         CardInstance[]
  wallet                Wallet?
  boosterOpenings       BoosterOpening[]
  tradesInitiated       Trade[]             @relation("TradeInitiator")
  tradesReceived        Trade[]             @relation("TradeRecipient")
  duelsChallenged       Duel[]              @relation("DuelChallenger")
  duelsOpposed          Duel[]              @relation("DuelOpponent")
  duelsWon              Duel[]              @relation("DuelWinner")
  wantedListings        WantedListing[]
  marketListings        MarketListing[]
  marketPurchases       MarketTransaction[] @relation("MarketBuyer")
  marketSales           MarketTransaction[] @relation("MarketSeller")
  marketBids            MarketBid[]
  auctionsLeading       MarketListing[]     @relation("MarketCurrentBidder")
  userMissions          UserMission[]
  userAchievements      UserAchievement[]
  notifications         Notification[]
  reportsFiled          Report[]            @relation("ReportReporter")
  reportsAgainst        Report[]            @relation("ReportTarget")
  auditLogs             AuditLog[]
  profile               UserProfile?
  dailyRewardClaims     DailyRewardClaim[]
  passwordResetTokens   PasswordResetToken[]
  favoriteCards         FavoriteCard[]
  seriesCompletions     UserSeriesCompletion[]
  guildsLed             Guild[]                @relation("GuildLeader")
  guildMembership       GuildMember?
  guildMessages         GuildMessage[]
  questProgress         UserQuestProgress[]
  seasonPoints          SeasonPoint[]
  friendshipsRequested  Friendship[]           @relation("FriendshipRequester")
  friendshipsReceived   Friendship[]           @relation("FriendshipAddressee")
  seasonPassClaims      SeasonPassClaim[]

  @@index([status])
}

model UserProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio               String?
  isPublic          Boolean  @default(true)
  xp                Int      @default(0)
  level             Int      @default(1)
  dailyRewardStreak Int      @default(0)
  lastDailyRewardAt DateTime?
  lastFreeBoosterAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Invitation {
  id              String    @id @default(uuid())
  code            String    @unique
  createdByUserId String?
  createdBy       User?     @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id])
  email           String?
  maxUses         Int       @default(1)
  useCount        Int       @default(0)
  expiresAt       DateTime?
  usedByUserId    String?   @unique
  usedBy          User?     @relation("InvitationUsedBy", fields: [usedByUserId], references: [id])
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([code])
}

// ─────────────────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────────────────

enum CardCategory {
  ROLLING_STOCK
  STATION_PLACE
  PROFESSION
  DAILY_LIFE_HUMOR
  SPECIAL_EDITION
}

enum CardStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Rarity {
  id           String   @id @default(uuid())
  code         String   @unique // COMMON, UNCOMMON, RARE, EPIC, LEGENDARY, MYTHIC
  label        String
  order        Int      @unique // 1 = most common
  colorHex     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cardDefinitions  CardDefinition[]
  boosterPoolEntry BoosterPoolEntry[]
  cardPulls        BoosterPull[]
}

model CardSeries {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  description String?
  category    CardCategory
  isActive    Boolean      @default(true)
  releaseAt   DateTime?
  coverImageUrl String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  cards            CardDefinition[]
  boosterPoolEntries BoosterPoolEntry[]
  completions      UserSeriesCompletion[]
}

model CardDefinition {
  id                  String       @id @default(uuid())
  slug                String       @unique
  seriesId            String
  series              CardSeries   @relation(fields: [seriesId], references: [id])
  name                String
  description         String
  flavorText          String?
  category            CardCategory
  rarityId            String
  rarity              Rarity       @relation(fields: [rarityId], references: [id])
  imageUrl            String
  status              CardStatus   @default(DRAFT)
  combatStatsEnabled  Boolean      @default(false)
  combatStats         Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  instances        CardInstance[]
  poolEntries      BoosterPoolEntry[]
  pulls            BoosterPull[]
  favoritedBy      FavoriteCard[]
  wantedListings   WantedListing[]

  @@index([seriesId])
  @@index([rarityId])
  @@index([status])
  @@index([category])
}

/**
 * A card a player has chosen to showcase on their profile (max 5,
 * enforced in FavoritesService). `position` orders the showcase; deleting
 * either side cascades so a removed card silently drops out of favorites
 * instead of leaving a dangling reference.
 */
model FavoriteCard {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardDefinitionId String
  cardDefinition   CardDefinition @relation(fields: [cardDefinitionId], references: [id], onDelete: Cascade)
  position         Int
  createdAt        DateTime       @default(now())

  @@unique([userId, cardDefinitionId])
  @@unique([userId, position])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Collection
// ─────────────────────────────────────────────────────────────────────────

enum CardInstanceState {
  AVAILABLE
  RESERVED_TRADE
  RESERVED_MARKET
  ARCHIVED
}

enum AcquisitionSource {
  BOOSTER
  TRADE
  MARKET
  ADMIN_GRANT
  MISSION_REWARD
  ACHIEVEMENT_REWARD
  FOUNDER_GRANT
  CRAFT
}

model CardInstance {
  id               String            @id @default(uuid())
  cardDefinitionId String
  cardDefinition   CardDefinition    @relation(fields: [cardDefinitionId], references: [id])
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id])
  serialNumber     Int
  state            CardInstanceState @default(AVAILABLE)
  acquiredVia      AcquisitionSource
  acquiredAt       DateTime          @default(now())
  // Cosmetic-only holo/foil variant — no stat or rarity effect. Set by
  // foiling a duplicate group (see CardVariantsService); never by a normal
  // booster pull.
  isFoil           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  boosterPull      BoosterPull?
  tradeItems       TradeItem[]
  marketListings   MarketListing[]
  duelsAsChallenger Duel[] @relation("DuelChallengerCard")
  duelsAsOpponent   Duel[] @relation("DuelOpponentCard")

  @@index([ownerId])
  @@index([cardDefinitionId])
  @@index([state])
}

// ─────────────────────────────────────────────────────────────────────────
// Booster Engine
// ─────────────────────────────────────────────────────────────────────────

enum BoosterCategory {
  DISCOVERY
  CLASSIC
  THEMED
}

model BoosterDefinition {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  description String
  category    BoosterCategory
  priceCr     Int
  cardCount   Int
  imageUrl    String
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  pools    BoosterPool[]
  openings BoosterOpening[]
}

model BoosterPool {
  id                  String    @id @default(uuid())
  boosterDefinitionId String
  boosterDefinition   BoosterDefinition @relation(fields: [boosterDefinitionId], references: [id])
  rulesVersion        Int
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())

  entries  BoosterPoolEntry[]
  openings BoosterOpening[]

  @@unique([boosterDefinitionId, rulesVersion])
}

model BoosterPoolEntry {
  id            String      @id @default(uuid())
  boosterPoolId String
  boosterPool   BoosterPool @relation(fields: [boosterPoolId], references: [id], onDelete: Cascade)
  rarityId      String
  rarity        Rarity      @relation(fields: [rarityId], references: [id])
  // Optional scoping, independently combinable: restrict this entry's draw
  // to one card category, one series, or (rarest) one exact card — e.g. a
  // themed booster's entries set `category` instead of picking every series
  // in that category one by one.
  category      CardCategory?
  seriesId      String?
  series        CardSeries? @relation(fields: [seriesId], references: [id])
  cardDefinitionId String?
  cardDefinition CardDefinition? @relation(fields: [cardDefinitionId], references: [id])
  weight        Int

  @@index([boosterPoolId])
}

model BoosterOpening {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  boosterDefinitionId String
  boosterDefinition   BoosterDefinition @relation(fields: [boosterDefinitionId], references: [id])
  boosterPoolId       String
  boosterPool         BoosterPool @relation(fields: [boosterPoolId], references: [id])
  idempotencyKey      String   @unique
  pricePaidCr         Int
  walletTransactionId String?  @unique
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  openedAt            DateTime @default(now())

  pulls BoosterPull[]

  @@index([userId])
}

model BoosterPull {
  id               String         @id @default(uuid())
  boosterOpeningId String
  boosterOpening   BoosterOpening @relation(fields: [boosterOpeningId], references: [id], onDelete: Cascade)
  cardInstanceId   String         @unique
  cardInstance     CardInstance   @relation(fields: [cardInstanceId], references: [id])
  cardDefinitionId String
  cardDefinition   CardDefinition @relation(fields: [cardDefinitionId], references: [id])
  rarityId         String
  rarity           Rarity         @relation(fields: [rarityId], references: [id])
  position         Int

  @@index([boosterOpeningId])
}

// ─────────────────────────────────────────────────────────────────────────
// Economy
// ─────────────────────────────────────────────────────────────────────────

enum WalletTransactionType {
  WELCOME_BONUS
  BOOSTER_PURCHASE
  DAILY_REWARD
  MISSION_REWARD
  ACHIEVEMENT_REWARD
  SERIES_COMPLETION_REWARD
  MARKET_SALE
  MARKET_PURCHASE
  MARKET_FEE
  TRADE_CR_TRANSFER
  ADMIN_ADJUSTMENT
  COMPENSATION
  DUEL_WAGER
  DUEL_PAYOUT
  AUCTION_BID_HOLD
  AUCTION_BID_REFUND
  QUEST_REWARD
  GUILD_WAR_REWARD
  SEASON_PASS_REWARD
  GUILD_LEVEL_UP_REWARD
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}
// NOTE: a CHECK (balance >= 0) constraint is added via raw SQL in the
// initial migration (Prisma's schema DSL has no declarative CHECK support).
// Application code is the primary guard; the DB constraint is defense in depth.

model WalletTransaction {
  id             String                @id @default(uuid())
  walletId       String
  wallet         Wallet                @relation(fields: [walletId], references: [id])
  amount         Int
  balanceAfter   Int
  type           WalletTransactionType
  referenceType  String?
  referenceId    String?
  idempotencyKey String?               @unique
  metadata       Json?
  createdAt      DateTime              @default(now())

  boosterOpening BoosterOpening?

  @@index([walletId])
  @@index([referenceType, referenceId])
}

// ─────────────────────────────────────────────────────────────────────────
// Trading
// ─────────────────────────────────────────────────────────────────────────

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
  COUNTERED
}

enum TradeSide {
  INITIATOR
  RECIPIENT
}

model Trade {
  id            String      @id @default(uuid())
  initiatorId   String
  initiator     User        @relation("TradeInitiator", fields: [initiatorId], references: [id])
  recipientId   String
  recipient     User        @relation("TradeRecipient", fields: [recipientId], references: [id])
  status        TradeStatus @default(PENDING)
  initiatorCr   Int         @default(0)
  recipientCr   Int         @default(0)
  parentTradeId String?     @unique
  parentTrade   Trade?      @relation("TradeCounter", fields: [parentTradeId], references: [id])
  counterTrade  Trade?      @relation("TradeCounter")
  message       String?
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items TradeItem[]

  @@index([initiatorId])
  @@index([recipientId])
  @@index([status])
}

model TradeItem {
  id             String       @id @default(uuid())
  tradeId        String
  trade          Trade        @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  cardInstanceId String
  cardInstance   CardInstance @relation(fields: [cardInstanceId], references: [id])
  side           TradeSide

  @@index([tradeId])
  @@index([cardInstanceId])
}

enum DuelStat {
  POWER
  RELIABILITY
  CHARM
}

enum DuelStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

// A friendly wager between two players' combat-stat cards. Cards are never
// staked or transferred — only the CR wager moves, and only once the duel
// actually resolves (see DuelsService.accept), so a challenge nobody ever
// answers never leaves money in limbo.
model Duel {
  id                       String        @id @default(uuid())
  challengerId             String
  challenger               User          @relation("DuelChallenger", fields: [challengerId], references: [id])
  challengerCardInstanceId String
  challengerCardInstance   CardInstance  @relation("DuelChallengerCard", fields: [challengerCardInstanceId], references: [id])
  opponentId               String
  opponent                 User          @relation("DuelOpponent", fields: [opponentId], references: [id])
  opponentCardInstanceId   String?
  opponentCardInstance     CardInstance? @relation("DuelOpponentCard", fields: [opponentCardInstanceId], references: [id])
  wagerCr                  Int
  status                   DuelStatus    @default(PENDING)
  stat                     DuelStat?
  challengerValue          Int?
  opponentValue            Int?
  winnerId                 String?
  winner                   User?         @relation("DuelWinner", fields: [winnerId], references: [id])
  message                  String?
  expiresAt                DateTime
  respondedAt              DateTime?
  createdAt                DateTime      @default(now())

  @@index([challengerId])
  @@index([opponentId])
  @@index([status])
}

enum WantedListingStatus {
  OPEN
  FULFILLED
  CANCELLED
}

// A public "wanted" board: a player posts the card they're after (not a
// specific instance — anyone's copy qualifies) and what they'd give for
// it, in free text. Fulfilling one is a normal trade proposed by whoever
// answers it; this model is discovery only, not itself a trade contract,
// so the poster marks it fulfilled by hand once a trade closes the loop.
model WantedListing {
  id               String              @id @default(uuid())
  posterId         String
  poster           User                @relation(fields: [posterId], references: [id])
  cardDefinitionId String
  cardDefinition   CardDefinition      @relation(fields: [cardDefinitionId], references: [id])
  note             String?
  status           WantedListingStatus @default(OPEN)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([posterId])
  @@index([status])
  @@index([cardDefinitionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Marketplace
// ─────────────────────────────────────────────────────────────────────────

enum MarketListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

enum MarketListingType {
  FIXED
  AUCTION
}

model MarketListing {
  id              String              @id @default(uuid())
  sellerId        String
  seller          User                @relation(fields: [sellerId], references: [id])
  cardInstanceId  String
  cardInstance    CardInstance        @relation(fields: [cardInstanceId], references: [id])
  // For FIXED, the buy-it-now price. For AUCTION, the starting price.
  priceCr         Int
  feeBps          Int
  status          MarketListingStatus @default(ACTIVE)
  listingType     MarketListingType   @default(FIXED)
  auctionEndsAt   DateTime?
  // Denormalized cache of the leading bid, kept in lockstep with the
  // MarketBid history below — lets the listing itself answer "who's
  // winning and for how much" without an aggregate query, and its
  // (currentBidCr IS NULL OR currentBidCr < $new) guard is what makes
  // placing a bid race-safe.
  currentBidCr    Int?
  currentBidderId String?
  currentBidder   User?               @relation("MarketCurrentBidder", fields: [currentBidderId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  soldAt          DateTime?
  cancelledAt     DateTime?

  transaction MarketTransaction?
  bids        MarketBid[]

  @@index([sellerId])
  @@index([status])
  @@index([cardInstanceId])
  @@index([currentBidderId])
}

// Full bid history for an auction — MarketListing.currentBidCr/currentBidderId
// cache the leading row here for cheap reads.
model MarketBid {
  id        String        @id @default(uuid())
  listingId String
  listing   MarketListing @relation(fields: [listingId], references: [id])
  bidderId  String
  bidder    User          @relation(fields: [bidderId], references: [id])
  amountCr  Int
  createdAt DateTime      @default(now())

  @@index([listingId])
  @@index([bidderId])
}

model MarketTransaction {
  id          String        @id @default(uuid())
  listingId   String        @unique
  listing     MarketListing @relation(fields: [listingId], references: [id])
  buyerId     String
  buyer       User          @relation("MarketBuyer", fields: [buyerId], references: [id])
  sellerId    String
  seller      User          @relation("MarketSeller", fields: [sellerId], references: [id])
  priceCr     Int
  feeCr       Int
  createdAt   DateTime      @default(now())

  @@index([buyerId])
  @@index([sellerId])
}

// ─────────────────────────────────────────────────────────────────────────
// Progression
// ─────────────────────────────────────────────────────────────────────────

/**
 * The profile-rank ladder a player climbs as they level up (e.g. "Apprenti
 * aiguilleur" at level 1, "Chef de gare" at level 50). Admin-editable —
 * GradesService keeps an in-memory cache of these, refreshed on every
 * admin write, so `gradeForLevel` stays a synchronous lookup everywhere
 * it's called instead of needing a DB round trip.
 */
model Grade {
  id        String   @id @default(uuid())
  minLevel  Int      @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MissionGoalType {
  OPEN_BOOSTER
  COLLECT_UNIQUE_CARDS
  COMPLETE_TRADE
  SELL_ON_MARKET
  BUY_ON_MARKET
  LOGIN
  COMPLETE_SERIES
}

enum MissionResetPeriod {
  NONE
  DAILY
}

model Mission {
  id           String              @id @default(uuid())
  code         String              @unique
  title        String
  description  String
  goalType     MissionGoalType
  goalCount    Int
  rewardCr     Int                 @default(0)
  rewardXp     Int                 @default(0)
  resetPeriod  MissionResetPeriod  @default(NONE)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  userMissions UserMission[]
}

model UserMission {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id])
  periodKey   String    @default("PERMANENT")
  progress    Int       @default(0)
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, missionId, periodKey])
}

model Achievement {
  id          String          @id @default(uuid())
  code        String          @unique
  title       String
  description String
  goalType    MissionGoalType
  goalCount   Int
  rewardCr    Int             @default(0)
  rewardXp    Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement  @relation(fields: [achievementId], references: [id])
  progress      Int          @default(0)
  completedAt   DateTime?
  claimedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, achievementId])
}

model DailyRewardClaim {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  claimDate    DateTime @db.Date
  streakCount  Int
  rewardCr     Int
  rewardXp     Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([userId, claimDate])
}

// Recorded once the first time a player owns at least one copy of every
// PUBLISHED card in a series — never removed afterward (completion is a
// milestone, not a live status), and used both to render series progress
// and to make the COMPLETE_SERIES mission/achievement trigger idempotent.
model UserSeriesCompletion {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  seriesId    String
  series      CardSeries @relation(fields: [seriesId], references: [id])
  completedAt DateTime   @default(now())

  @@unique([userId, seriesId])
}

// ─────────────────────────────────────────────────────────────────────────
// Seasons
// ─────────────────────────────────────────────────────────────────────────

enum SeasonStatus {
  ACTIVE
  ENDED
}

// A resettable competitive cycle layered on top of the permanent XP/level
// system: SeasonPoint rows accumulate the same XP a player earns from
// missions/achievements/quests, scoped to whichever season is ACTIVE at
// grant time. Ending a season and starting a new one is how the seasonal
// leaderboard "resets" without touching a player's permanent XP, level, or
// grade — those are never rolled back.
model Season {
  id        String       @id @default(uuid())
  name      String
  status    SeasonStatus @default(ACTIVE)
  startedAt DateTime     @default(now())
  endedAt   DateTime?

  points    SeasonPoint[]
  passTiers SeasonPassTier[]
}

model SeasonPoint {
  id       String @id @default(uuid())
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  points   Int    @default(0)

  @@unique([seasonId, userId])
  @@index([seasonId])
}

// A ladder of milestone rewards over a season's own SeasonPoint tally —
// authored per season (so each season can offer different rewards), and
// claimed once each by any player whose tally has reached that tier's
// threshold. Independent of the permanent XP/level rewards: this is a
// bonus layered on top, not a replacement.
model SeasonPassTier {
  id             String   @id @default(uuid())
  seasonId       String
  season         Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  tier           Int
  pointsRequired Int
  rewardCr       Int      @default(0)
  rewardXp       Int      @default(0)
  // Free-text cosmetic reward (a title, a flourish) — display-only, no
  // separate cosmetic-item system backs it.
  rewardLabel    String?
  createdAt      DateTime @default(now())

  claims SeasonPassClaim[]

  @@unique([seasonId, tier])
  @@index([seasonId])
}

model SeasonPassClaim {
  id        String         @id @default(uuid())
  tierId    String
  tier      SeasonPassTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  claimedAt DateTime       @default(now())

  @@unique([tierId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Live Ops
// ─────────────────────────────────────────────────────────────────────────

model Event {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  description   String
  bannerImageUrl String?
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean  @default(true)
  // Basis points applied to every XP grant while the event is live and in
  // its [startsAt, endsAt] window (10000 = 1x, 20000 = 2x/"double XP").
  // Same units as MarketListing.feeBps, for the same reason: exact integer
  // math, no floating-point surprises.
  xpMultiplierBps Int    @default(10000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A single admin-authored site-wide notice shown under the navbar (e.g. a
// maintenance heads-up). Always exactly one row — `upsert`d in place rather
// than versioned like SeasonalQuest/Event, since there's nothing to browse
// historically and no reason to keep old announcements around.
model SiteAnnouncement {
  id        String   @id @default("singleton")
  message   String
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

enum QuestStatus {
  ACTIVE
  ARCHIVED
}

// A seasonal narrative questline: an ordered chain of steps players clear
// one at a time. Each step reuses MissionGoalType for its goal, so the same
// MissionsService.recordProgress() call sites already wired at every action
// (booster opened, trade completed, card sold, ...) drive quest progress
// too — no new instrumentation needed anywhere else. At most one quest is
// ACTIVE at a time (enforced in QuestsService, not the DB); authoring a new
// one is all-or-nothing, so a season is never half-written mid-play.
model SeasonalQuest {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  description String
  status      QuestStatus @default(ACTIVE)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  steps QuestStep[]
}

model QuestStep {
  id        String        @id @default(uuid())
  questId   String
  quest     SeasonalQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  narrative String
  goalType  MissionGoalType
  goalCount Int
  rewardCr  Int           @default(0)
  rewardXp  Int           @default(0)

  progress UserQuestProgress[]

  @@unique([questId, order])
}

model UserQuestProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  questStepId String
  questStep   QuestStep @relation(fields: [questStepId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  completedAt DateTime?
  claimedAt   DateTime?

  @@unique([userId, questStepId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// Guilds
// ─────────────────────────────────────────────────────────────────────────

enum GuildRole {
  LEADER
  OFFICER
  MEMBER
}

// A small player-run group. Membership is exclusive — GuildMember.userId is
// unique, so a player is in at most one guild at a time. Leaving/kicking/
// disbanding all go through GuildsService rather than a DB cascade, since
// a departing leader needs leadership handed to someone else first (or the
// guild disbanded if they were the last member).
model Guild {
  id          String   @id @default(uuid())
  name        String   @unique
  tag         String   @unique
  description String?
  leaderId    String
  leader      User     @relation("GuildLeader", fields: [leaderId], references: [id])
  createdAt   DateTime @default(now())
  // The guild's own permanent, never-resetting XP pool and level — see
  // GuildsService.bumpXp. Independent of the season-scoped GuildWarPoint
  // tally and of the live-computed "total member XP" leaderboard.
  xp          Int      @default(0)
  level       Int      @default(1)

  members   GuildMember[]
  messages  GuildMessage[]
  warPoints GuildWarPoint[]

  @@index([leaderId])
}

model GuildMember {
  id       String    @id @default(uuid())
  guildId  String
  guild    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id])
  role     GuildRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@index([guildId])
}

// A guild's chat log. Membership is checked at post/read time (not stored
// per-message), so a message stays visible in history even after its
// author leaves — same rationale as trade/duel history outliving the cards
// involved.
model GuildMessage {
  id        String   @id @default(uuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
}

enum GuildWarStatus {
  ACTIVE
  ENDED
}

// A resettable inter-guild competition, layered on top of the existing
// all-time guild leaderboard (Guild.leaderboard, ranked by permanent member
// XP): GuildWarPoint accumulates the same bonus-eligible XP as SeasonPoint
// (mission/achievement/quest claims), scoped to whichever period is ACTIVE
// and to the earning member's guild. Ending a period distributes CR rewards
// to the members of the top 3 guilds, then a new period starts the count
// back at zero — same "reset without touching anything permanent" shape as
// a season.
model GuildWarPeriod {
  id        String         @id @default(uuid())
  name      String
  status    GuildWarStatus @default(ACTIVE)
  startedAt DateTime       @default(now())
  endedAt   DateTime?

  points GuildWarPoint[]
}

model GuildWarPoint {
  id       String         @id @default(uuid())
  periodId String
  period   GuildWarPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  guildId  String
  guild    Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  points   Int            @default(0)

  @@unique([periodId, guildId])
  @@index([periodId])
}

// ─────────────────────────────────────────────────────────────────────────
// Social / Moderation / Audit
// ─────────────────────────────────────────────────────────────────────────

enum NotificationType {
  TRADE_RECEIVED
  TRADE_ACCEPTED
  TRADE_REJECTED
  TRADE_CANCELLED
  TRADE_COUNTERED
  TRADE_EXPIRED
  MARKET_SOLD
  MISSION_COMPLETED
  ACHIEVEMENT_UNLOCKED
  LEVEL_UP
  CREDITS_EARNED
  SERIES_COMPLETED
  DUEL_RECEIVED
  DUEL_RESOLVED
  DUEL_DECLINED
  DUEL_CANCELLED
  DUEL_EXPIRED
  AUCTION_OUTBID
  AUCTION_NEW_BID
  AUCTION_WON
  AUCTION_ENDED_NO_BIDS
  GUILD_KICKED
  GUILD_PROMOTED
  GUILD_DEMOTED
  GUILD_LEADERSHIP_TRANSFERRED
  GUILD_DISBANDED
  QUEST_STEP_COMPLETED
  QUEST_COMPLETED
  WANTED_CARD_LISTED
  GUILD_WAR_REWARD
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
  FRIEND_REQUEST_DECLINED
  SEASON_PASS_REWARD
  GUILD_LEVELED_UP
  SYSTEM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// A friend relationship starts as one PENDING row (requester -> addressee)
// and transitions to ACCEPTED in place — never a second row — so the
// @@unique below is enough to stop duplicate/competing requests between the
// same two players. Symmetric membership (either side is "the friend of the
// other") is resolved in code, not by a second mirrored row.
model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id])
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, readAt])
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("ReportReporter", fields: [reporterId], references: [id])
  targetUserId   String
  targetUser     User         @relation("ReportTarget", fields: [targetUserId], references: [id])
  reason         String
  details        String?
  status         ReportStatus @default(OPEN)
  resolvedByUserId String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status])
  @@index([targetUserId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id])
  action       String
  targetType   String
  targetId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([action])
}
