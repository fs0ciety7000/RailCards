{
  "name": "railcards",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "pnpm --filter @railcards/database prisma:generate",
    "db:migrate": "pnpm --filter @railcards/database prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @railcards/database prisma:migrate:deploy",
    "db:seed": "pnpm --filter @railcards/database prisma:seed",
    "db:studio": "pnpm --filter @railcards/database prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "@prisma/client": "6.19.3",
    "eslint": "10.11.0",
    "typescript-eslint": "8.70.1",
    "@eslint/js": "^9.18.0",
    "eslint-config-prettier": "10.1.8"
  }
}
